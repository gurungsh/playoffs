{
  "realm": "playoffs",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "sslRequired": "external",
  "roles": {
    "realm": [
      { "name": "Admin", "description": "Bypasses tournament ownership" },
      { "name": "Organizer", "description": "Creates and runs tournaments" },
      { "name": "Referee", "description": "Reports match results" }
    ]
  },
  "clients": [
    {
      "clientId": "playoffs-web",
      "protocolMappers": [
        {
          "name": "tournament-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "playoffs-tournament",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ],
      "name": "Playoffs Web (MVC)",
      "enabled": true,
      "publicClient": false,
      "secret": "${WEB_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:5200/signin-oidc", "https://localhost:7200/signin-oidc"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5200/*##https://localhost:7200/*"
      }
    },
    {
      "clientId": "playoffs-dev-cli",
      "protocolMappers": [
        {
          "name": "tournament-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "playoffs-tournament",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ],
      "name": "Dev only: password grant for curl and tests",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true
    },
    {
      "clientId": "playoffs-service",
      "protocolMappers": [
        {
          "name": "tournament-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "playoffs-tournament",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ],
      "name": "Playoffs service-to-service",
      "enabled": true,
      "publicClient": false,
      "secret": "${SERVICE_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    { "id": "00000000-0000-4000-8000-000000000001", "username": "admin", "email": "admin@playoffs.test", "firstName": "Ada", "lastName": "Admin", "enabled": true, "emailVerified": true, "realmRoles": ["Admin"], "credentials": [{ "type": "password", "value": "${SEED_USER_PASSWORD}", "temporary": false }] },
    { "id": "00000000-0000-4000-8000-000000000002", "username": "organizer1", "email": "organizer1@playoffs.test", "firstName": "Olga", "lastName": "Organizer", "enabled": true, "emailVerified": true, "realmRoles": ["Organizer"], "credentials": [{ "type": "password", "value": "${SEED_USER_PASSWORD}", "temporary": false }] },
    { "id": "00000000-0000-4000-8000-000000000003", "username": "organizer2", "email": "organizer2@playoffs.test", "firstName": "Omar", "lastName": "Organizer", "enabled": true, "emailVerified": true, "realmRoles": ["Organizer"], "credentials": [{ "type": "password", "value": "${SEED_USER_PASSWORD}", "temporary": false }] },
    { "id": "00000000-0000-4000-8000-000000000004", "username": "referee1", "email": "referee1@playoffs.test", "firstName": "Rita", "lastName": "Referee", "enabled": true, "emailVerified": true, "realmRoles": ["Referee"], "credentials": [{ "type": "password", "value": "${SEED_USER_PASSWORD}", "temporary": false }] },
    { "id": "00000000-0000-4000-8000-000000000005", "username": "referee2", "email": "referee2@playoffs.test", "firstName": "Raj", "lastName": "Referee", "enabled": true, "emailVerified": true, "realmRoles": ["Referee"], "credentials": [{ "type": "password", "value": "${SEED_USER_PASSWORD}", "temporary": false }] }
  ]
}
